# Copy this file to .env and fill in real values before running with a live LLM.
# NetSage AI works with zero configuration in mock mode (the default).

# MOCK_MODE=true  -> no API key needed, deterministic mock diagnoses (default)
# MOCK_MODE=false -> calls the real Anthropic API (requires ANTHROPIC_API_KEY)
MOCK_MODE=true

# Only required when MOCK_MODE=false
ANTHROPIC_API_KEY=your-api-key-here
